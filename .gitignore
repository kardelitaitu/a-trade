# C dependencies
node_modules/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# Virtual environment
.venv/
venv/
env/

# Jupyter checkpoints (but track actual notebooks)
.ipynb_checkpoints/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Data files (raw data is large and should not be committed)
*.parquet
*.csv
*.feather
*.h5
*.hdf5

# Logs
*.log

# Results — ignore generated data but track structure (.gitkeep)
results/**/*.parquet
results/**/*.csv
results/**/*.feather
results/**/*.h5
results/**/*.png
results/**/*.html

# OS
.DS_Store
Thumbs.db

# Config with secrets
config/credentials*.yaml
config/credentials*.toml
config/.env
*.env
